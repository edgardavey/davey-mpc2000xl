// Icon id 32512 = IDI_APPLICATION: the webview library loads that id for the window icon, Explorer shows the first icon.
32512 ICON "app.ico"

1 VERSIONINFO
FILEVERSION 4,0,0,0
PRODUCTVERSION 4,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DAVEY (built on vubeatz's work, github.com/dariuszchynek)"
      VALUE "FileDescription", "DAVEY MPC PATCHER"
      VALUE "FileVersion", "4.0.0.0"
      VALUE "InternalName", "DAVEY_MPC_PATCHER"
      VALUE "LegalCopyright", "Free and open source, never sold"
      VALUE "OriginalFilename", "DAVEY MPC PATCHER.exe"
      VALUE "ProductName", "DAVEY MPC PATCHER"
      VALUE "ProductVersion", "4.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
